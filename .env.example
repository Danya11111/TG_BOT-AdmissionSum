# Telegram Bot Token (РїРѕР»СѓС‡РёС‚Рµ Сѓ @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# GigaChat API credentials
# РџРѕР»СѓС‡РёС‚Рµ client_id Рё client_secret РЅР° https://developers.sber.ru/
# Р—Р°С‚РµРј Р·Р°РєРѕРґРёСЂСѓР№С‚Рµ РёС… РІ Base64: echo -n "client_id:client_secret" | base64
GIGACHAT_AUTH_BASIC=your_base64_encoded_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_TLS=true

# Qdrant РЅР°СЃС‚СЂРѕР№РєРё (РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ localhost)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=guu_documents
